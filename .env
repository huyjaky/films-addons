# PostgreSQL / pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=huyhuyhuy12
POSTGRES_DB=aiostreams
STREMTHRU_POSTGRES_DB=stremthru
PGDATA=/var/lib/postgresql/18/docker

# PhimAPI addon
PHIMAPI_PORT=7000
PHIMAPI_URL=https://phimapi.com/v1/api
OPHIM_URL=https://ophim1.com/v1/api
SEARCH_LIMIT=100
NODE_ENV=production

# Valkey - dùng DB 0 cho AIOStreams và DB 1 cho StremThru
VALKEY_PASSWORD=1d4fc3c507b4153e306c5ef16571f122928398b07a91914e
VALKEY_MAXMEMORY=512mb

# StremThru chỉ hoạt động trong Docker network, không mở ra host
STREMTHRU_BASE_URL=http://stremthru:8080
STREMTHRU_USERNAME=duckq1u
# BẮT BUỘC: thay giá trị dưới đây bằng API key thật lấy từ TorBox
TORBOX_API_KEY=0804b654-7bfa-4ce8-b52e-6c8a21718d8c
STREMTHRU_PORT=8080
STREMTHRU_DATA_DIR=/app/data
STREMTHRU_LOG_LEVEL=INFO
STREMTHRU_LOG_FORMAT=json
STREMTHRU_DATABASE_URI=postgresql://postgres:huyhuyhuy12@pgvector:5432/stremthru?max_conns=20&min_conns=2
STREMTHRU_REDIS_URI=redis://:1d4fc3c507b4153e306c5ef16571f122928398b07a91914e@valkey:6379/1
STREMTHRU_AUTH=duckq1u:huyhuyhuy12
STREMTHRU_AUTH_ADMIN=duckq1u
# Không proxy video qua server: thiết bị tải trực tiếp từ CDN TorBox
STREMTHRU_STORE_CONTENT_PROXY=torbox:false,*:false
STREMTHRU_STORE_CONTENT_CACHED_STALE_TIME=*:24h:8h
STREMTHRU_CONTENT_PROXY_CONNECTION_LIMIT=*:0
STREMTHRU_TUNNEL=*:false
STREMTHRU_STORE_TUNNEL=*:false
STREMTHRU_VAULT_SECRET=7c30c2a7172827c43419694396e83fd09a48e1ebd3d2c966db0fae9d9121b74e

# StremThru Newz - hữu ích cho TorBox Usenet trong AIOStreams
STREMTHRU_STREMIO_NEWZ_INDEXER_MAX_TIMEOUT=15s
STREMTHRU_STREMIO_NEWZ_PLAYBACK_WAIT_TIME=15s
STREMTHRU_NEWZ_MAX_CONNECTION_PER_STREAM=8
STREMTHRU_NEWZ_NZB_FILE_CACHE_SIZE=512MB
STREMTHRU_NEWZ_SEGMENT_CACHE_SIZE=2GB
STREMTHRU_NEWZ_STREAM_BUFFER_SIZE=200MB

# StremThru Torz - tìm torrent nhanh, tải metadata nền
STREMTHRU_STREMIO_TORZ_INDEXER_MAX_TIMEOUT=10s
STREMTHRU_STREMIO_TORZ_LAZY_PULL=true
STREMTHRU_TORZ_TORRENT_FILE_CACHE_SIZE=256MB
STREMTHRU_TORZ_TORRENT_FILE_CACHE_TTL=6h

# StremThru Store - catalog thư viện debrid
STREMTHRU_STREMIO_STORE_CATALOG_ITEM_LIMIT=2000
STREMTHRU_STREMIO_STORE_CATALOG_CACHE_TIME=10m

# AIOStreams
BASE_URL=https://aiostreams.duckq1linux.id.vn
AIOSTREAMS_SECRET_KEY=30776ca0ebbf479269aecc66c3980d2f45024b747647f925cc61236e52c37410
DATABASE_URI=postgres://postgres:huyhuyhuy12@pgvector:5432/aiostreams
AIOSTREAMS_REDIS_URI=redis://:1d4fc3c507b4153e306c5ef16571f122928398b07a91914e@valkey:6379/0
AIOSTREAMS_REDIS_TIMEOUT=5000
AIOSTREAMS_AUTH=duckq1u:huyhuyhuy12
MAX_ADDONS=100
DISABLE_RATE_LIMITS=true
ANALYTICS_ENABLED=false
USER_ANALYTICS_ENABLED=false
BUILTIN_STREMTHRU_URL=http://stremthru:8080
STREMTHRU_STORE_URL=http://stremthru:8080/stremio/store
STREMTHRU_TORZ_URL=http://stremthru:8080/stremio/torz
ENCRYPT_STREMTHRU_URLS=true
TORBOX_USENET_VIA_STREMTHRU=true
BUILTIN_DEBRID_INSTANT_AVAILABILITY_CACHE_TTL=1800
BUILTIN_DEBRID_PLAYBACK_LINK_CACHE_TTL=3600
BUILTIN_DEBRID_LIBRARY_CACHE_TTL=604800
BUILTIN_GET_TORRENT_LAZILY=true

# TorBox-only: AIOStreams ẩn/khóa toàn bộ dịch vụ khác
DISABLED_SERVICES=realdebrid:TorBox only,alldebrid:TorBox only,premiumize:TorBox only,debridlink:TorBox only,torrin:TorBox only,offcloud:TorBox only,putio:TorBox only,easynews:TorBox only,easydebrid:TorBox only,debrider:TorBox only,pikpak:TorBox only,seedr:TorBox only,nzbdav:TorBox only,altmount:TorBox only,stremio_nntp:TorBox only,aiostreams:TorBox only
TORBOX_STREMIO_URL=https://stremio.torbox.app
DEFAULT_TORBOX_TIMEOUT=15000
BUILTIN_TORBOX_SEARCH_SEARCH_API_TIMEOUT=30000
BUILTIN_TORBOX_SEARCH_SEARCH_API_CACHE_TTL=604800
BUILTIN_TORBOX_SEARCH_METADATA_CACHE_TTL=1209600

# Hiệu năng tìm kiếm/preload TorBox
BUILTIN_SCRAPE_QUERY_CONCURRENCY=8
BUILTIN_GET_TORRENT_TIMEOUT=5000
BUILTIN_GET_TORRENT_CONCURRENCY=100
PRELOAD_STREAMS_CONCURRENCY=8
PRELOAD_MIN_INTERVAL=1800
BACKGROUND_RESOURCE_REQUESTS_ENABLED=true
BACKGROUND_RESOURCE_REQUEST_TIMEOUT=30000
