# PostgreSQL / pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=aiostreams
STREMTHRU_POSTGRES_DB=stremthru
AIOMETADATA_POSTGRES_DB=aiometadata
PGDATA=/var/lib/postgresql/18/docker

# AIO Metadata
AIOMETADATA_HOST_NAME=aiometadata.18-140-204-81.sslip.io
AIOMETADATA_DATABASE_URI=postgresql://postgres:change_me@pgvector:5432/aiometadata
AIOMETADATA_REDIS_URL=redis://:change_me@valkey:6379/2
AIOMETADATA_TMDB_API_KEY=your_tmdb_api_key
ENABLE_BUILTIN_POSTER_CACHE=true
POSTER_CACHE_BACKGROUNDS=true
POSTER_CACHE_LOGOS=true
POSTER_CACHE_PROCESSED_IMAGES=true
POSTER_CACHE_MAX_SIZE=5g
POSTER_CACHE_MEMORY_SIZE=128m
PREFER_SMALLER_LOGOS_TMDB=true
PREFER_SMALLER_LANDSCAPE_TMDB=true

# PhimAPI addon
PHIMAPI_PORT=7000
PHIMAPI_URL=https://phimapi.com/v1/api
OPHIM_URL=https://ophim1.com/v1/api
SEARCH_LIMIT=100
NODE_ENV=production

# Valkey
VALKEY_PASSWORD=change_me
VALKEY_MAXMEMORY=512mb

# StremThru
STREMTHRU_BASE_URL=http://stremthru:8080
STREMTHRU_USERNAME=change_me
TORBOX_API_KEY=your_torbox_api_key
STREMTHRU_PORT=8080
STREMTHRU_DATA_DIR=/app/data
STREMTHRU_LOG_LEVEL=INFO
STREMTHRU_LOG_FORMAT=json
STREMTHRU_DATABASE_URI=postgresql://postgres:change_me@pgvector:5432/stremthru?max_conns=20&min_conns=2
STREMTHRU_REDIS_URI=redis://:change_me@valkey:6379/1
STREMTHRU_AUTH=change_me:change_me
STREMTHRU_AUTH_ADMIN=change_me
STREMTHRU_STORE_CONTENT_PROXY=torbox:false,*:false
STREMTHRU_STORE_CONTENT_CACHED_STALE_TIME=*:24h:8h
STREMTHRU_CONTENT_PROXY_CONNECTION_LIMIT=*:0
STREMTHRU_TUNNEL=*:false
STREMTHRU_STORE_TUNNEL=*:false
STREMTHRU_VAULT_SECRET=change_me

# StremThru Newz
STREMTHRU_STREMIO_NEWZ_INDEXER_MAX_TIMEOUT=15s
STREMTHRU_STREMIO_NEWZ_PLAYBACK_WAIT_TIME=15s
STREMTHRU_NEWZ_MAX_CONNECTION_PER_STREAM=8
STREMTHRU_NEWZ_NZB_FILE_CACHE_SIZE=512MB
STREMTHRU_NEWZ_SEGMENT_CACHE_SIZE=2GB
STREMTHRU_NEWZ_STREAM_BUFFER_SIZE=200MB

# StremThru Torz
STREMTHRU_STREMIO_TORZ_INDEXER_MAX_TIMEOUT=10s
STREMTHRU_STREMIO_TORZ_LAZY_PULL=true
STREMTHRU_TORZ_TORRENT_FILE_CACHE_SIZE=256MB
STREMTHRU_TORZ_TORRENT_FILE_CACHE_TTL=6h

# StremThru Store
STREMTHRU_STREMIO_STORE_CATALOG_ITEM_LIMIT=2000
STREMTHRU_STREMIO_STORE_CATALOG_CACHE_TIME=10m

# AIOStreams
BASE_URL=https://aiostreams.18-140-204-81.sslip.io
AIOSTREAMS_SECRET_KEY=change_me
DATABASE_URI=postgres://postgres:change_me@pgvector:5432/aiostreams
AIOSTREAMS_REDIS_URI=redis://:change_me@valkey:6379/0
AIOSTREAMS_REDIS_TIMEOUT=5000
AIOSTREAMS_AUTH=change_me:change_me
MAX_ADDONS=100
DISABLE_RATE_LIMITS=true
ANALYTICS_ENABLED=false
USER_ANALYTICS_ENABLED=false
BUILTIN_STREMTHRU_URL=http://stremthru:8080
STREMTHRU_STORE_URL=http://stremthru:8080/stremio/store
STREMTHRU_TORZ_URL=http://stremthru:8080/stremio/torz
STREMTHRU_NEWZ_URL=http://stremthru:8080/stremio/newz
ENCRYPT_STREMTHRU_URLS=false
TORBOX_USENET_VIA_STREMTHRU=true
BUILTIN_DEBRID_INSTANT_AVAILABILITY_CACHE_TTL=1800
BUILTIN_DEBRID_PLAYBACK_LINK_CACHE_TTL=3600
BUILTIN_DEBRID_LIBRARY_CACHE_TTL=604800
BUILTIN_GET_TORRENT_LAZILY=false

# TorBox-only
DISABLED_SERVICES=realdebrid:TorBox only,alldebrid:TorBox only,premiumize:TorBox only,debridlink:TorBox only,torrin:TorBox only,offcloud:TorBox only,putio:TorBox only,easynews:TorBox only,easydebrid:TorBox only,debrider:TorBox only,pikpak:TorBox only,seedr:TorBox only,nzbdav:TorBox only,altmount:TorBox only,stremio_nntp:TorBox only
TORBOX_STREMIO_URL=https://stremio.torbox.app
DEFAULT_TORBOX_TIMEOUT=15000
BUILTIN_TORBOX_SEARCH_SEARCH_API_TIMEOUT=30000
BUILTIN_TORBOX_SEARCH_SEARCH_API_CACHE_TTL=604800
BUILTIN_TORBOX_SEARCH_METADATA_CACHE_TTL=1209600

# Hiệu năng tìm kiếm/preload TorBox
BUILTIN_SCRAPE_QUERY_CONCURRENCY=8
BUILTIN_GET_TORRENT_TIMEOUT=5000
BUILTIN_GET_TORRENT_CONCURRENCY=100
PRELOAD_STREAMS_CONCURRENCY=8
PRELOAD_MIN_INTERVAL=1800
BACKGROUND_RESOURCE_REQUESTS_ENABLED=true
BACKGROUND_RESOURCE_REQUEST_TIMEOUT=30000

# Dockhand Agent (Hawser)
HAWSER_PORT=2376
HAWSER_TOKEN=your_secure_dockhand_agent_token_here

